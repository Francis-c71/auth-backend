NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/auth_backend

# Frontend origin(s), comma separated. Used for CORS and email links.
CLIENT_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=qubit13gugdhgdghjh@jhdgbhdbdhfouop8r8h88r8hr8bg9rerh7eg3
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
REQUIRE_EMAIL_VERIFICATION=true

# Set to true for mobile/non-browser clients that can't use cookies
RETURN_REFRESH_TOKEN_IN_BODY=false

# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Heroku)
TRUST_PROXY=0

# SMTP (leave SMTP_HOST empty in dev to print emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Auth App <no-reply@example.com>"
